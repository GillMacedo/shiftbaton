#!/usr/bin/env python3
"""Stands in for claude in tests and the demo. FAKE_SCRIPT lists one action per call: commit, idle, fail, error, junk, slow, done, blocked."""
import json, os, subprocess, sys, time
from pathlib import Path

if os.environ.get("FAKE_LOG"):
    with open(os.environ["FAKE_LOG"], "a") as log:
        log.write(json.dumps(sys.argv[1:]) + "\n")
counter = Path(".git/fake-count")
number = int(counter.read_text()) if counter.exists() else 0
counter.write_text(str(number + 1))
actions = os.environ.get("FAKE_SCRIPT", "commit").split(",")
action = actions[min(number, len(actions) - 1)]
cost = float(os.environ.get("FAKE_COST", "0.25"))
result = {"type": "result", "subtype": "success", "is_error": False, "result": "ok", "num_turns": 3, "session_id": f"s{number}", "total_cost_usd": cost}
if action in ("commit", "done"):
    Path("work.txt").write_text(f"shift {number}\n")
    subprocess.run(["git", "add", "work.txt"], check=True)
    subprocess.run(["git", "-c", "user.name=Demo", "-c", "user.email=demo@example.com", "commit", "-qm", f"Shift {number}"], check=True)
if action == "done":
    Path("DONE").touch()
if action == "blocked":
    Path("BLOCKED").write_text("Which database should this use?\n")
if action == "dirty":
    Path("dirty.txt").write_text("unfinished\n")
if action == "slow":
    time.sleep(5)
if action == "junk":
    print("not json")
    sys.exit(1)
if action == "error":
    # The real CLI reports subtype success with is_error true when it isn't logged in.
    result.update(is_error=True, result="Not logged in · Please run /login", total_cost_usd=0)
    print(json.dumps(result))
    sys.exit(1)
print(json.dumps(result))
